func sortedReplicaValues(valid map[string]ReplicaInfo) []ReplicaInfo {
	result := make([]ReplicaInfo, 0, len(valid))
	for _, r := range valid {
		result = append(result, r)
	}
	sort.Slice(result, func(i, j int) bool {
		return result[i].Node < result[j].Node
	})
	return result
}

func reconcileOneFile(
	file FileRecord,
	nodes []NodeRecord,
	nodeByName map[string]NodeRecord,
) {
	replicas, err := loadReplicas(file.Name)
	if err != nil {
		log.Printf("Reconcile %s: cannot load replicas: %v",
			file.Name, err)
		return
	}
	if len(replicas) == 0 {
		log.Printf("Reconcile %s: no replica records; cannot recover without a source",
			file.Name)
		return
	}

	// Check the contents of each registered replica whose node is online.
	checks := make(map[string]ReplicaCheck)
	for _, replica := range replicas {
		n, exists := nodeByName[replica.Node]
		if !exists || n.Status != "online" {
			checks[replica.Node] = ReplicaCheck{
				Replica: replica,
				Err:     fmt.Errorf("node is not online"),
			}
			continue
		}

		replica.Address = n.Address
		hash, size, hashErr := hashRemoteFile(n.Address, file.Name)
		checks[replica.Node] = ReplicaCheck{
			Replica: replica,
			Hash:    hash,
			Size:    size,
			Err:     hashErr,
		}
	}

	canonicalHash := file.SHA256

	// Older files may not have a stored checksum. Establish it only
	// when a strict majority of readable copies agree.
	if canonicalHash == "" {
		counts := make(map[string]int)
		sizes := make(map[string]int64)
		readableCount := 0

		for _, check := range checks {
			if check.Err != nil {
				continue
			}
			counts[check.Hash]++
			sizes[check.Hash] = check.Size
			readableCount++
		}

		bestHash := ""
		bestCount := 0
		tie := false
		for hash, count := range counts {
			if count > bestCount {
				bestHash = hash
				bestCount = count
				tie = false
			} else if count == bestCount {
				tie = true
			}
		}

		if bestHash == "" || tie || bestCount*2 <= readableCount {
			log.Printf(
				"Reconcile %s: legacy checksum missing and no clear majority; "+
					"not repairing or deleting copies",
				file.Name,
			)
			return
		}

		currentHash, _, err := establishLegacyChecksum(
			file.Name, sizes[bestHash], bestHash,
		)
		if err != nil {
			log.Printf("Reconcile %s: cannot store checksum: %v",
				file.Name, err)
			return
		}
		canonicalHash = currentHash
	}

	// Find existing replicas that match the canonical checksum.
	valid := make(map[string]ReplicaInfo)
	for node, check := range checks {
		if check.Err == nil && check.Hash == canonicalHash {
			valid[node] = check.Replica
		}
	}

	if len(valid) == 0 {
		log.Printf(
			"Reconcile %s: no online replica matches canonical SHA-256 %s; "+
				"refusing to guess which copy is correct",
			file.Name, canonicalHash,
		)
		return
	}

	// Repair missing or stale replicas on existing online nodes first.
	for _, replica := range replicas {
		if _, ok := valid[replica.Node]; ok {
			continue
		}

		target, exists := nodeByName[replica.Node]
		if !exists || target.Status != "online" {
			continue
		}

		sources := sortedReplicaValues(valid)
		if len(sources) == 0 {
			break
		}

		log.Printf("Reconcile %s: repairing replica on %s",
			file.Name, target.Node)

		if err := copyReplica(file.Name, sources[0], target); err != nil {
			log.Printf("Reconcile %s: repair on %s failed: %v",
				file.Name, target.Node, err)
			continue
		}

		hash, _, err := hashRemoteFile(target.Address, file.Name)
		if err != nil || hash != canonicalHash {
			log.Printf("Reconcile %s: verification failed on %s",
				file.Name, target.Node)
			continue
		}

		valid[target.Node] = ReplicaInfo{
			Node:    target.Node,
			Address: target.Address,
		}
	}

	// Try unused online nodes if there are still too few valid copies.
	usedNodes := make(map[string]bool)
	for _, replica := range replicas {
		usedNodes[replica.Node] = true
	}

	for len(valid) < desiredReplicationFactor {
		sources := sortedReplicaValues(valid)
		if len(sources) == 0 {
			break
		}

		var target *NodeRecord
		for i := range nodes {
			if nodes[i].Status == "online" && !usedNodes[nodes[i].Node] {
				target = &nodes[i]
				break
			}
		}

		if target == nil {
			log.Printf(
				"Reconcile %s: only %d healthy verified copies; "+
					"no unused online node is available",
				file.Name, len(valid),
			)
			break
		}

		usedNodes[target.Node] = true
		log.Printf("Reconcile %s: creating replacement on %s",
			file.Name, target.Node)

		if err := copyReplica(file.Name, sources[0], *target); err != nil {
			log.Printf("Reconcile %s: copy to %s failed: %v",
				file.Name, target.Node, err)
			continue
		}

		hash, _, err := hashRemoteFile(target.Address, file.Name)
		if err != nil || hash != canonicalHash {
			log.Printf("Reconcile %s: verification failed on new replica %s",
				file.Name, target.Node)
			continue
		}

		valid[target.Node] = ReplicaInfo{
			Node:    target.Node,
			Address: target.Address,
		}
	}

	// Delete excess copies only after at least the target number
	// of distinct, healthy, checksum-verified replicas exists.
	verified := sortedReplicaValues(valid)
	if len(verified) <= desiredReplicationFactor {
		return
	}

	for _, extra := range verified[desiredReplicationFactor:] {
		log.Printf("Reconcile %s: removing excess replica from %s",
			file.Name, extra.Node)

		if err := deleteRemoteReplica(file.Name, extra); err != nil {
			log.Printf("Reconcile %s: cannot delete copy on %s: %v",
				file.Name, extra.Node, err)
			continue
		}

		if err := deleteReplicaRecord(file.Name, extra.Node); err != nil {
			log.Printf("Reconcile %s: deleted data on %s but could not "+
				"remove metadata record: %v",
				file.Name, extra.Node, err)
			continue
		}

		log.Printf("Reconcile %s: removed excess replica on %s",
			file.Name, extra.Node)
	}
}

func checkNodesOnce() {
	nodes, err := loadNodes()
	if err != nil {
		log.Printf("Health monitor: cannot load nodes: %v", err)
		return
	}

	for _, node := range nodes {
		if err := checkNode(node.Address); err != nil {
			updateNodeStatus(node.Node, "offline", err.Error())
		} else {
			updateNodeStatus(node.Node, "online", "")
		}
	}
}

func nodeMonitorLoop() {
	log.Printf("Node monitor started; interval %s", nodeCheckInterval)
	for {
		checkNodesOnce()
		time.Sleep(nodeCheckInterval)
	}
}

func reconciliationLoop() {
	log.Printf("Replica reconciler started; interval %s; target RF=%d",
		reconciliationInterval, desiredReplicationFactor)

	for {
		time.Sleep(reconciliationInterval)

		nodes, err := loadNodes()
		if err != nil {
			log.Printf("Reconciler: cannot load nodes: %v", err)
			continue
		}

		nodeByName := make(map[string]NodeRecord)
		for _, n := range nodes {
			nodeByName[n.Node] = n
		}

		files, err := loadFiles()
		if err != nil {
			log.Printf("Reconciler: cannot load files: %v", err)
			continue
		}

		for _, file := range files {
			reconcileOneFile(file, nodes, nodeByName)
		}
	}
}

func main() {
	if err := initializeDatabase(); err != nil {
		log.Fatal("Database initialization failed: ", err)
	}
	defer db.Close()

	mux := http.NewServeMux()
	mux.HandleFunc("/add", addFileHandler)
	mux.HandleFunc("/get", getFileHandler)
	mux.HandleFunc("/list", listFilesHandler)
	mux.HandleFunc("/health", healthHandler)
	mux.HandleFunc("/register-node", registerNodeHandler)
	mux.HandleFunc("/register-replica", registerReplicaHandler)
	mux.HandleFunc("/nodes", nodesHandler)

	go nodeMonitorLoop()
	go reconciliationLoop()

	port := os.Getenv("METADATA_PORT")
	if port == "" {
		port = "9000"
	}

	log.Println("Metadata Server listening on port", port)
	log.Println("SQLite database: ./metadata.db")

	log.Fatal(http.ListenAndServe(":"+port, mux))
}
