func initializeDatabase() error {
	var err error

	db, err = sql.Open("sqlite", "./metadata.db")
	if err != nil {
		return err
	}

	db.SetMaxOpenConns(1)

	_, err = db.Exec(`
		PRAGMA foreign_keys = ON;

		CREATE TABLE IF NOT EXISTS files (
			name TEXT PRIMARY KEY,
			size INTEGER NOT NULL,
			sha256 TEXT NOT NULL DEFAULT ''
		);

		CREATE TABLE IF NOT EXISTS replicas (
			file_name TEXT NOT NULL,
			node TEXT NOT NULL,
			address TEXT NOT NULL,
			path TEXT NOT NULL,
			PRIMARY KEY (file_name, node),
			FOREIGN KEY (file_name)
				REFERENCES files(name)
				ON DELETE CASCADE
		);

		CREATE TABLE IF NOT EXISTS nodes (
			node TEXT PRIMARY KEY,
			address TEXT NOT NULL,
			status TEXT NOT NULL DEFAULT 'unknown',
			last_seen TEXT,
			last_error TEXT NOT NULL DEFAULT ''
		);
	`)
	if err != nil {
		return err
	}

	// Migrate an existing database that predates the checksum column.
	if err := ensureColumn(
		"files", "sha256", "TEXT NOT NULL DEFAULT ''",
	); err != nil {
		return err
	}

	return db.Ping()
}

func ensureColumn(table, column, definition string) error {
	// These table and column names are internal constants, not user input.
	rows, err := db.Query("PRAGMA table_info(" + table + ")")
	if err != nil {
		return err
	}

	found := false
	for rows.Next() {
		var cid int
		var name, dataType string
		var notNull, primaryKey int
		var defaultValue interface{}

		if err := rows.Scan(
			&cid, &name, &dataType, &notNull,
			&defaultValue, &primaryKey,
		); err != nil {
			rows.Close()
			return err
		}

		if name == column {
			found = true
		}
	}
	if err := rows.Err(); err != nil {
		rows.Close()
		return err
	}
	if err := rows.Close(); err != nil {
		return err
	}

	if found {
		return nil
	}

	_, err = db.Exec(
		"ALTER TABLE " + table + " ADD COLUMN " +
			column + " " + definition,
	)
	return err
}

func validSHA256(value string) bool {
	if len(value) != 64 {
		return false
	}
	_, err := hex.DecodeString(value)
	return err == nil
}

func registerNodeHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet && r.Method != http.MethodPost {
		http.Error(w, "Use GET or POST",
			http.StatusMethodNotAllowed)
		return
	}

	node := r.URL.Query().Get("node")
	address := r.URL.Query().Get("address")
	if node == "" || address == "" {
		http.Error(w, "Missing node or address",
			http.StatusBadRequest)
		return
	}

	dbMu.Lock()
	defer dbMu.Unlock()

	_, err := db.Exec(`
		INSERT INTO nodes(node, address, status, last_error)
		VALUES(?, ?, 'unknown', '')
		ON CONFLICT(node) DO UPDATE SET
			address = excluded.address,
			status = 'unknown',
			last_error = ''
	`, node, address)
	if err != nil {
		http.Error(w, "Cannot register node",
			http.StatusInternalServerError)
		return
	}

	fmt.Fprintf(w, "Node registered: %s\n", node)
}

// Add or update the canonical file metadata and an ordinary replica.
func addFileHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet && r.Method != http.MethodPost {
		http.Error(w, "Use GET or POST",
			http.StatusMethodNotAllowed)
		return
	}

	q := r.URL.Query()
	name := q.Get("name")
	node := q.Get("node")
	address := q.Get("address")
	path := q.Get("path")
	hash := strings.ToLower(q.Get("sha256"))

	if name == "" || node == "" || address == "" || path == "" {
		http.Error(w, "Missing name, node, address or path",
			http.StatusBadRequest)
		return
	}

	size, err := strconv.ParseInt(q.Get("size"), 10, 64)
	if err != nil || size < 0 {
		http.Error(w, "Invalid file size",
			http.StatusBadRequest)
		return
	}
	if hash != "" && !validSHA256(hash) {
		http.Error(w, "Invalid SHA-256 checksum",
			http.StatusBadRequest)
		return
	}

	dbMu.Lock()
	defer dbMu.Unlock()

	tx, err := db.Begin()
	if err != nil {
		http.Error(w, "Database error",
			http.StatusInternalServerError)
		return
	}
	defer tx.Rollback()

	_, err = tx.Exec(`
		INSERT INTO files(name, size, sha256)
		VALUES(?, ?, ?)
		ON CONFLICT(name) DO UPDATE SET
			size = excluded.size,
			sha256 = CASE
				WHEN excluded.sha256 <> ''
				THEN excluded.sha256
				ELSE files.sha256
			END
	`, name, size, hash)
	if err != nil {
		http.Error(w, "Cannot save file metadata",
			http.StatusInternalServerError)
		return
	}

	_, err = tx.Exec(`
		INSERT INTO nodes(node, address, status, last_error)
		VALUES(?, ?, 'unknown', '')
		ON CONFLICT(node) DO UPDATE SET
			address = excluded.address
	`, node, address)
	if err != nil {
		http.Error(w, "Cannot register storage node",
			http.StatusInternalServerError)
		return
	}

	_, err = tx.Exec(`
		INSERT INTO replicas(file_name, node, address, path)
		VALUES(?, ?, ?, ?)
		ON CONFLICT(file_name, node) DO UPDATE SET
			address = excluded.address,
			path = excluded.path
	`, name, node, address, path)
	if err != nil {
		http.Error(w, "Cannot save replica metadata",
			http.StatusInternalServerError)
		return
	}

	if err := tx.Commit(); err != nil {
		http.Error(w, "Cannot commit metadata",
			http.StatusInternalServerError)
		return
	}

	fmt.Fprintf(w, "Metadata registered for %s on %s\n", name, node)
}

// Register a repaired copy only if its checksum matches the canonical file.
// Unlike /add, this endpoint never changes the canonical checksum.
func registerReplicaHandler(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet && r.Method != http.MethodPost {
		http.Error(w, "Use GET or POST",
			http.StatusMethodNotAllowed)
		return
	}

	q := r.URL.Query()
	name := q.Get("name")
	node := q.Get("node")
	address := q.Get("address")
	path := q.Get("path")
	hash := strings.ToLower(q.Get("sha256"))

	if name == "" || node == "" || address == "" ||
		path == "" || !validSHA256(hash) {
		http.Error(w, "Missing or invalid replica registration data",
			http.StatusBadRequest)
		return
	}

	size, err := strconv.ParseInt(q.Get("size"), 10, 64)
	if err != nil || size < 0 {
		http.Error(w, "Invalid file size",
			http.StatusBadRequest)
		return
	}

	dbMu.Lock()
	defer dbMu.Unlock()

	var canonicalHash string
	var canonicalSize int64
	err = db.QueryRow(
		"SELECT size, sha256 FROM files WHERE name = ?",
		name,
	).Scan(&canonicalSize, &canonicalHash)
	if err == sql.ErrNoRows {
		http.Error(w, "Canonical file metadata not found",
			http.StatusNotFound)
		return
	}
	if err != nil {
		http.Error(w, "Cannot read canonical file metadata",
			http.StatusInternalServerError)
		return
	}
	if canonicalHash == "" {
		http.Error(w,
			"Canonical checksum is not established; cannot register recovery",
			http.StatusConflict)
		return
	}
	if hash != canonicalHash || size != canonicalSize {
		http.Error(w, "Recovered copy does not match canonical file",
			http.StatusConflict)
		return
	}

	tx, err := db.Begin()
	if err != nil {
		http.Error(w, "Database error",
			http.StatusInternalServerError)
		return
	}
	defer tx.Rollback()

	_, err = tx.Exec(`
		INSERT INTO nodes(node, address, status, last_error)
		VALUES(?, ?, 'unknown', '')
		ON CONFLICT(node) DO UPDATE SET
			address = excluded.address
	`, node, address)
	if err != nil {
		http.Error(w, "Cannot register node",
			http.StatusInternalServerError)
		return
	}

	_, err = tx.Exec(`
		INSERT INTO replicas(file_name, node, address, path)
		VALUES(?, ?, ?, ?)
		ON CONFLICT(file_name, node) DO UPDATE SET
			address = excluded.address,
			path = excluded.path
	`, name, node, address, path)
	if err != nil {
		http.Error(w, "Cannot register recovered replica",
			http.StatusInternalServerError)
		return
	}

	if err := tx.Commit(); err != nil {
		http.Error(w, "Cannot commit recovered replica",
			http.StatusInternalServerError)
		return
	}

	fmt.Fprintf(w, "Verified replica registered for %s on %s\n",
		name, node)
}

func getFileHandler(w http.ResponseWriter, r *http.Request) {
	name := r.URL.Query().Get("name")
	if name == "" {
		http.Error(w, "Missing file name",
			http.StatusBadRequest)
		return
	}

	var result FileMetadata
	err := db.QueryRow(`
		SELECT name, size, COALESCE(sha256, '')
		FROM files WHERE name = ?
	`, name).Scan(&result.Name, &result.Size, &result.SHA256)

	if err == sql.ErrNoRows {
		http.Error(w, "File metadata not found",
			http.StatusNotFound)
		return
	}
	if err != nil {
		http.Error(w, "Database error",
			http.StatusInternalServerError)
		return
	}

	rows, err := db.Query(`
		SELECT node, address, path
		FROM replicas
		WHERE file_name = ?
		ORDER BY node
	`, name)
	if err != nil {
		http.Error(w, "Cannot read replica metadata",
			http.StatusInternalServerError)
		return
	}
	defer rows.Close()

	result.Replicas = []ReplicaInfo{}
	for rows.Next() {
		var replica ReplicaInfo
		if err := rows.Scan(
			&replica.Node,
			&replica.Address,
			&replica.Path,
		); err != nil {
			http.Error(w, "Cannot read replica",
				http.StatusInternalServerError)
			return
		}
		result.Replicas = append(result.Replicas, replica)
	}
	if err := rows.Err(); err != nil {
		http.Error(w, "Cannot read replicas",
			http.StatusInternalServerError)
		return
	}

	w.Header().Set("Content-Type", "application/json")
	_ = json.NewEncoder(w).Encode(result)
}

